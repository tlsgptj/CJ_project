<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".myPageProfile">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/group5"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"/>

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ellipse" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용자"
        android:textSize="40dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="240dp"
        android:layout_marginLeft="140dp"/>

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/person"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="155dp"/>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="390dp"
        android:layout_marginLeft="100dp"
        android:textSize="25dp"
        android:textColor="@color/black"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="330dp"
        android:layout_marginLeft="35dp"
        android:text="권한 근무자"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="390dp"
        android:text="성함"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="430dp"
        android:layout_marginLeft="35dp"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:text="연락처"/>

    <TextView
        android:id="@+id/phoneNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="430dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이메일"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="470dp"
        android:textColor="@color/black"
        android:textSize="20dp"/>

    <TextView
        android:id="@+id/email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="470dp"
        android:layout_marginLeft="120dp"
        android:textSize="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="530dp"
        android:layout_marginLeft="35dp"
        android:text="푸시 메세지 보내기"/>

    <CheckBox
        android:id="@+id/allow1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="허용"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginLeft="250dp"
        android:layout_marginTop="530dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="570dp"
        android:text="권한 변경"/>

    <CheckBox
        android:id="@+id/allow2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="허용"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginLeft="250dp"
        android:layout_marginTop="570dp"/>

    <Button
        android:id="@+id/home"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/home"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="825dp"/>

    <Button
        android:id="@+id/chartPic"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/chartpic"
        android:layout_marginLeft="190dp"
        android:layout_marginTop="825dp"/>

    <Button
        android:id="@+id/my_page_go"
        android:layout_width="35dp"
        android:layout_height="40dp"
        android:layout_marginTop="825dp"
        android:layout_marginLeft="300dp"
        android:background="@drawable/people"/>

</FrameLayout>