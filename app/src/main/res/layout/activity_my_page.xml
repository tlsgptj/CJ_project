<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".my_page">

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용자"
        android:layout_marginTop="260dp"
        android:layout_marginLeft="155dp"
        android:textColor="@color/black"
        android:textSize="30dp"/>

    <ImageView
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:layout_marginLeft="165dp"
        android:layout_marginTop="150dp"
        android:background="@drawable/people"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="계정"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="320dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="350dp"
        android:text="프로필 수정"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="400dp"
        android:text="비밀번호 변경"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="450dp"
        android:text="푸시 알람 설정"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="500dp"
        android:text="신고 내역 조회"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="고객지원"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="560dp"
        android:layout_marginLeft="20dp"
        android:textStyle="bold"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="공지 사항"
        android:layout_marginTop="590dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 : 1 문의"
        android:layout_marginTop="640dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="고객 센터"
        android:layout_marginTop="690dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="환경설정"
        android:layout_marginTop="740dp"/>

    <Button
        android:id="@+id/home"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/home"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="825dp"/>

    <Button
        android:id="@+id/chartPic"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/chartpic"
        android:layout_marginLeft="190dp"
        android:layout_marginTop="825dp"/>

    <Button
        android:id="@+id/my_page_go"
        android:layout_width="35dp"
        android:layout_height="40dp"
        android:layout_marginTop="825dp"
        android:layout_marginLeft="300dp"
        android:background="@drawable/people"/>

</FrameLayout>